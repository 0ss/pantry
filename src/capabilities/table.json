      "packages": ["qs", "query-string"],
      "native": { "name": "URLSearchParams", "note": "URLSearchParams handles all common cases" },
      "exclusive": true
    },
    {
      "id": "deep-ops",
      "label": "deep object ops",
      "synonyms": ["deep equal", "deep clone", "deep copy", "compare objects"],
