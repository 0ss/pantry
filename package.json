{
  "name": "pantry-check",
  "version": "0.1.0",
  "description": "Stop your AI agent from reinventing code. Check the pantry before shopping.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0ss/pantry.git"
  },
  "homepage": "https://github.com/0ss/pantry#readme",
  "bugs": {
    "url": "https://github.com/0ss/pantry/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pantry": "dist/cli.js"
  },
  "files": ["dist", "skills", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "cli",
    "ai-agents",
    "claude-code",
    "dependencies",
    "code-reuse",
    "duplicate-code",
    "developer-tools"
  ],
  "dependencies": {
    "oxc-parser": "^0.72.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
